# JAN SETU - Environment Configuration
APP_NAME="JAN SETU"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="127.0.0.1"

# Database Configuration (SQLite default for local setup; easily migratable to PostgreSQL)
DATABASE_URL="sqlite:///./jan_setu.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://user:password@localhost:5432/jan_setu"

# Privacy & Security
MAX_FILE_SIZE_MB=5
ALLOWED_EXTENSIONS=["pdf", "png", "jpg", "jpeg"]
AUTO_PURGE_TEMP_UPLOADS=True
MASK_AADHAAR=True

# Language & Voice (Bhashini Adapter)
# If credentials are not provided, system operates in local browser SpeechSynthesis / fallback mode
BHASHINI_USER_ID=""
BHASHINI_API_KEY=""
BHASHINI_PIPELINE_ID=""

# Optional LLM Integration (Read-only explanation simplifier only; NEVER used for decision making)
OPENAI_API_KEY=""
